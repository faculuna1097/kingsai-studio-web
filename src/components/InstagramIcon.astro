---
// Glifo de Instagram en línea fina, a tono con las flechas y los botones de 1 px.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25">
  <rect x="3" y="3" width="18" height="18" rx="5" />
  <circle cx="12" cy="12" r="4" />
  <circle cx="17.25" cy="6.75" r="0.6" fill="currentColor" stroke="none" />
</svg>
