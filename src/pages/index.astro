---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Sparkle from '../components/Sparkle.astro';
import Arrow from '../components/Arrow.astro';
import EstadoLocal from '../components/EstadoLocal.astro';
import Mapa from '../components/Mapa.astro';
import InstagramIcon from '../components/InstagramIcon.astro';
import localFoto from '../assets/local.webp';
import logo from '../assets/logo.webp';
import { SITE, FULL_ADDRESS, bookingUrl } from '../config';
import { getServicios, getBarberos, getHorarios, formatPrecio } from '../lib/data';

const servicios = await getServicios();
const barberos = await getBarberos();
const horarios = await getHorarios();

// Para mostrar: las franjas de un mismo grupo de días van en una sola fila
// ("Lunes a viernes: 10:00 a 13:00 y 16:00 a 20:00").
const horariosPorDias = horarios.reduce<{ label: string; days: string[]; franjas: string[] }[]>((filas, h) => {
  const franja = `${h.opens} a ${h.closes}`;
  const ultima = filas[filas.length - 1];
  if (ultima?.label === h.label) ultima.franjas.push(franja);
  else filas.push({ label: h.label, days: h.days, franjas: [franja] });
  return filas;
}, []);

// "@kingsai.studio", sacado del link de Instagram.
const instagramUsuario = SITE.instagram?.match(/instagram\.com\/([^/?#]+)/)?.[1];

// Respuestas confirmadas por la barbería (oct-2026). Sirven también para la ficha de Google.
const faq = [
  {
    q: '¿Cómo saco turno?',
    a: 'Online, desde el botón Reservar: elegís el servicio, el barbero y el horario que te queden cómodos.',
  },
  {
    q: '¿Atienden sin turno?',
    a: 'Sí. Con turno te asegurás el horario.',
  },
  {
    q: '¿Puedo elegir barbero?',
    a: 'Sí, lo elegís al reservar.',
  },
  {
    q: '¿Cómo cancelo o cambio un turno?',
    a: 'Desde el link del mail de confirmación que te llega al reservar.',
  },
  {
    q: '¿Qué medios de pago aceptan?',
    a: 'Efectivo, Mercado Pago y tarjeta.',
  },
  {
    q: '¿Hacen diseños o color?',
    a: 'No, no hacemos diseños, tintura ni decoloración.',
  },
  {
    q: '¿Venden productos?',
    a: 'Sí, los tenemos en el local.',
  },
  {
    q: '¿Dónde queda la barbería?',
    a: `En ${FULL_ADDRESS}.`,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: SITE.name,
  url: Astro.site?.toString(),
  image: new URL('/media/hero-poster.jpg', Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    postalCode: SITE.address.postalCode,
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  ...(SITE.geo && { geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng } }),
  ...(SITE.whatsapp && { telephone: `+${SITE.whatsapp}` }),
  ...(horarios.length && {
    openingHoursSpecification: horarios.map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.days,
      opens: h.opens,
      closes: h.closes,
    })),
  }),
  sameAs: [SITE.instagram, SITE.googleMaps].filter(Boolean),
  makesOffer: servicios.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s.nombre },
    ...(s.precio != null && { price: s.precio, priceCurrency: 'ARS' }),
  })),
};
---

<Layout
  title={`Barbería en Pilar | ${SITE.name}`}
  description={`${SITE.name}: cortes, fade y barba en ${SITE.address.street}, Pilar. Reservá tu turno online.`}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero" data-hero>
    <!-- En pantallas anchas: el mismo video, desenfocado, llena el fondo. -->
    <div class="hero__ambient" aria-hidden="true">
      <canvas width="36" height="64" data-hero-ambient></canvas>
    </div>
    <div class="hero__media">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster="/media/hero-poster.jpg"
        aria-label="Recorrido por el local de Kingsai Studio"
        data-hero-video
      >
        <source src="/media/hero.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="hero__content">
      <hr class="tube hero__tube" />
      <h1 class="hero__title">Kingsai<br />Studio</h1>
      {
        SITE.instagram && instagramUsuario && (
          <a class="hero__ig" href={SITE.instagram} rel="noopener" aria-label={`Instagram de ${SITE.name}: @${instagramUsuario}`}>
            <InstagramIcon />
            <span>@{instagramUsuario}</span>
          </a>
        )
      }
      <EstadoLocal horarios={horarios} class="hero__estado" />
      <div class="hero__actions">
        <a class="btn btn--solid" href={bookingUrl('hero')}>Reservar turno <Arrow /></a>
        <a class="link" href="#servicios">Ver servicios y precios</a>
      </div>
    </div>
  </section>

  <!-- Nosotros: el local, la raíz tattoo y cómo llegar -->
  <section class="nosotros section" id="nosotros" aria-labelledby="nosotros-titulo">
    <h2 id="nosotros-titulo" class="visually-hidden">Nosotros</h2>
    <div class="wrap local__grid">
      <p class="local__statement">
        Paredes grafito, techo negro y tubos de luz blanca. Una luz que no perdona: por eso cada línea sale
        prolija.
      </p>
      <figure class="local__figure">
        <Image
          src={localFoto}
          alt="Interior de Kingsai Studio: sillones con capas a rayas, espejos altos y tubos de luz blanca cruzando el techo negro"
          widths={[480, 729]}
          sizes="(min-width: 56rem) 45vw, 100vw"
        />
        <figcaption>{SITE.address.street}, Pilar</figcaption>
      </figure>
    </div>

    <div class="wrap raiz">
      <div class="raiz__logo">
        <Image src={logo} alt="Logo de Kingsai Studio: la Virgen entre dos rosas rojas, en estilo tattoo tradicional" width={486} />
      </div>
      <div class="raiz__texto">
        <h3 class="nosotros__titulo">
          Raíz tattoo
          <Sparkle class="raiz__sparkle" />
        </h3>
        <p class="lede">
          La marca viene del tattoo tradicional: la Virgen, las rosas rojas, los destellos. En las paredes cuelga flash
          enmarcado. El resto es silencio, buena luz y oficio.
        </p>
      </div>
    </div>

    <div class="wrap llegar" id="como-llegar">
      <div class="llegar__texto">
        <h3 class="nosotros__titulo">Cómo llegar</h3>
        <!-- Forma de decirlo en el barrio. La dirección exacta (para Google) sigue en config.ts. -->
        <address class="llegar__address">
          {SITE.address.street},<br />
          Manuel Alberti - {SITE.address.locality}, {SITE.address.region}
        </address>
        <a class="btn llegar__btn" href={SITE.googleMaps} rel="noopener">Abrir en Google Maps <Arrow /></a>
      </div>
      {SITE.geo && <Mapa lat={SITE.geo.lat} lng={SITE.geo.lng} />}
    </div>
  </section>

  <!-- Servicios -->
  <section class="servicios section" id="servicios" aria-labelledby="servicios-titulo">
    <div class="wrap">
      <h2 id="servicios-titulo">Servicios</h2>
      <ul class="servicios__list" role="list">
        {
          servicios.map((s) => (
            <li class="servicio">
              <a class="servicio__link" href={`/servicios/${s.slug}`}>
                <span class="servicio__nombre">{s.nombre}</span>
                <span class="servicio__precio">{formatPrecio(s.precio)}</span>
                {s.descripcion && <span class="servicio__meta">{s.descripcion}</span>}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn servicios__cta" href={bookingUrl('servicios')}>Elegir horario <Arrow /></a>
    </div>
  </section>

  <!-- Equipo -->
  {
    barberos.length > 0 && (
      <section class="equipo section" id="barberos" aria-labelledby="equipo-titulo">
        <div class="wrap equipo__grid">
          <div class="equipo__intro">
            <h2 id="equipo-titulo">Quién te corta</h2>
            <p class="equipo__texto">Elegís con quién al reservar.</p>
            <a class="link" href={bookingUrl('barberos')}>Reservar con tu barbero</a>
          </div>
          <ul class="equipo__list" role="list">
            {barberos.map((b) => (
              <li class="barbero">
                {/* Cuadro flash, como los de las paredes: la foto va adentro cuando exista. */}
                <div class="flash">
                  <div class="flash__interior">
                    {b.fotoUrl ? (
                      <img src={b.fotoUrl} alt={`${b.nombre}, barbero de ${SITE.name}`} loading="lazy" />
                    ) : (
                      <span class="flash__monograma" aria-hidden="true">
                        {b.nombre.trim().charAt(0)}
                      </span>
                    )}
                  </div>
                  <Sparkle class="flash__destello flash__destello--arriba" />
                  <Sparkle class="flash__destello flash__destello--abajo" />
                </div>
                <p class="barbero__nombre">{b.nombre}</p>
                {b.rol && <p class="barbero__rol">{b.rol}</p>}
                {b.instagram && (
                  <a class="link barbero__ig" href={b.instagram} rel="noopener">
                    Ver trabajos
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Preguntas -->
  <section class="faq section" aria-labelledby="faq-titulo">
    <div class="wrap faq__grid">
      <h2 id="faq-titulo">Preguntas</h2>
      <div class="faq__list">
        {
          faq.map((item) => (
            <details class="faq__item">
              <summary>
                {item.q}
                <span class="faq__icon" aria-hidden="true" />
              </summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contacto: estado, horarios y canales -->
  <section class="contacto section" id="contacto" aria-labelledby="contacto-titulo">
    <div class="wrap contacto__grid">
      <div>
        <h2 id="contacto-titulo">Contacto</h2>
        <EstadoLocal horarios={horarios} class="contacto__estado" />
        {
          horariosPorDias.length > 0 && (
            <dl class="contacto__hours">
              {horariosPorDias.map((h) => (
                <div data-dias={h.days.join(',')}>
                  <dt>{h.label}</dt>
                  <dd>{h.franjas.join(' y ')}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>

      <div class="contacto__canales">
        <a class="btn btn--solid" href={bookingUrl('contacto')}>Reservar turno <Arrow /></a>
        <ul class="canales" role="list">
          {
            SITE.instagram && (
              <li>
                <a class="canal" href={SITE.instagram} rel="noopener">
                  <span class="canal__nombre">Instagram</span>
                  {instagramUsuario && <span class="canal__dato">@{instagramUsuario}</span>}
                  <Arrow />
                </a>
              </li>
            )
          }
          {
            SITE.whatsapp && (
              <li>
                <a class="canal" href={`https://wa.me/${SITE.whatsapp}`} rel="noopener">
                  <span class="canal__nombre">WhatsApp</span>
                  <span class="canal__dato">Escribinos</span>
                  <Arrow />
                </a>
              </li>
            )
          }
          <li>
            <a class="canal" href="#como-llegar">
              <span class="canal__nombre">Dirección</span>
              <span class="canal__dato">{SITE.address.street}</span>
              <Arrow />
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  // Con movimiento reducido el video queda quieto en el primer cuadro.
  if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.removeAttribute('autoplay');
    video.pause();
  }

  // Fondo del hero en pantallas anchas: copia el video cuadro a cuadro en un
  // canvas diminuto que el CSS agranda y desenfoca. Un solo video, siempre sincronizado.
  const ambient = document.querySelector<HTMLCanvasElement>('[data-hero-ambient]');
  const ctx = ambient?.getContext('2d');
  const wide = window.matchMedia('(min-width: 56rem)');

  if (video && ambient && ctx) {
    let running = 0; // id del loop activo; 0 = detenido
    let visible = true;

    const draw = () => {
      if (video.readyState < 2) return;
      ctx.drawImage(video, 0, 0, ambient.width, ambient.height);
      ambient.classList.add('is-live');
    };
    const next = (cb: () => void) =>
      'requestVideoFrameCallback' in video ? video.requestVideoFrameCallback(cb) : requestAnimationFrame(cb);
    const loop = (id: number) => {
      if (id !== running) return;
      draw();
      next(() => loop(id));
    };
    const sync = () => {
      const active = wide.matches && visible;
      const play = active && !video.paused;
      if (active) draw();
      if (play && !running) {
        const id = (running = performance.now());
        next(() => loop(id));
      }
      if (!play) running = 0;
    };

    ['play', 'pause', 'loadeddata'].forEach((e) => video.addEventListener(e, sync));
    wide.addEventListener('change', sync);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(ambient);
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    isolation: isolate;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__media::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, oklch(0.145 0.008 255 / 0.55), transparent 22%),
      linear-gradient(to top, var(--night) 4%, oklch(0.145 0.008 255 / 0.7) 38%, transparent 70%);
    content: '';
    pointer-events: none;
  }

  .hero__content {
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
    padding-bottom: clamp(6.5rem, 18vw, 7.5rem);
  }

  .hero__tube {
    width: 4.5rem;
    margin-bottom: 1.75rem;
    transform-origin: left;
    animation: tube-on 1.4s var(--ease-out) 0.2s both;
  }

  .hero__title {
    font-size: clamp(4rem, 19vw, 6rem);
    font-variation-settings: 'opsz' 96;
    line-height: 0.92;
    letter-spacing: -0.02em;
    animation: focus-in 1.4s var(--ease-out) 0.35s both;
  }

  .hero__ig {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: fit-content;
    min-height: 2.75rem;
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 1.0625rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 0.3s;
    animation: focus-in 1.2s var(--ease-out) 0.6s both;
  }

  .hero__ig:hover {
    color: var(--light);
  }

  .hero__ig :global(svg) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }

  .hero :global(.hero__estado) {
    margin-top: 0.5rem;
    animation: focus-in 1.2s var(--ease-out) 0.68s both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 2rem;
    animation: focus-in 1.2s var(--ease-out) 0.75s both;
  }

  @keyframes tube-on {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }
    40% {
      opacity: 1;
    }
    55% {
      opacity: 0.35;
    }
    65%,
    100% {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @keyframes focus-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: translateY(12px);
    }
  }

  .hero__ambient {
    display: none;
  }

  /* En pantallas anchas: el video nítido ocupa todo el alto, sin estirarse,
     y el mismo video desenfocado llena el resto, como la luz del local. */
  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: 1fr auto;
      gap: clamp(2rem, 5vw, 5rem);
      padding-inline: max(var(--gutter), (100% - var(--max)) / 2);
    }

    /* El póster cubre mientras el video carga; el desenfoque va sobre todo el bloque. */
    .hero__ambient {
      position: absolute;
      z-index: -2;
      inset: 0;
      display: block;
      background: url('/media/hero-poster.jpg') center / cover;
      filter: blur(36px) saturate(0.7) brightness(0.55);
      transform: scale(1.15);
    }

    .hero__ambient canvas {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 1.2s var(--ease-out);
    }

    .hero__ambient canvas:global(.is-live) {
      opacity: 1;
    }

    /* Oscurece el lado del texto para que el título se lea siempre. */
    .hero::before {
      position: absolute;
      z-index: -1;
      inset: 0;
      background:
        linear-gradient(to bottom, oklch(0.145 0.008 255 / 0.6), transparent 20%),
        linear-gradient(to right, oklch(0.145 0.008 255 / 0.85) 20%, oklch(0.145 0.008 255 / 0.45));
      content: '';
    }

    .hero__media {
      position: relative;
      z-index: 0;
      inset: auto;
      grid-column: 2;
      grid-row: 1;
      align-self: stretch;
      width: min(100svh * 9 / 16, 45vw);
      box-shadow: 0 0 80px oklch(0.145 0.008 255 / 0.6);
    }

    .hero__media::after {
      background:
        linear-gradient(to bottom, oklch(0.145 0.008 255 / 0.6), transparent 20%),
        linear-gradient(to top, oklch(0.145 0.008 255 / 0.4), transparent 35%);
    }

    .hero__content {
      grid-column: 1;
      grid-row: 1;
      width: auto;
      margin: 0;
      padding: calc(var(--header-h) + 3rem) 0 clamp(4rem, 9vh, 6.5rem);
    }

    .hero__title {
      font-size: clamp(5rem, 9vw, 6rem);
    }
  }

  /* ---------- El local ---------- */
  .local__grid {
    display: grid;
    gap: 3rem;
  }

  .local__statement {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 6.5vw, 2.75rem);
    line-height: 1.18;
    text-wrap: balance;
  }

  .local__figure {
    margin: 0;
  }

  .local__figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .local__figure figcaption {
    margin-top: 0.875rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 56rem) {
    .local__grid {
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: 6rem;
    }

    .local__statement {
      padding-bottom: 4rem;
    }
  }

  /* ---------- Servicios ---------- */
  .servicios {
    background: var(--graphite);
  }

  .servicios__list {
    margin: 3rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .servicio {
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  /* Al pasar, la línea se enciende como un tubo. */
  .servicio::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    background: var(--light);
    box-shadow: 0 0 10px oklch(1 0 0 / 0.6);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }

  .servicio:hover::after,
  .servicio:focus-within::after {
    transform: scaleX(1);
  }

  .servicio__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.375rem 1.5rem;
    align-items: baseline;
    padding-block: 1.5rem;
    text-decoration: none;
  }

  .servicio__nombre {
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 6vw, 2.25rem);
    line-height: 1.1;
  }

  .servicio__precio {
    font-size: 1.0625rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .servicio__meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    max-width: 60ch;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .servicios__cta {
    margin-top: 2.5rem;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .servicio {
        animation: row-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }

  @keyframes row-in {
    from {
      opacity: 0.2;
      transform: translateY(1.25rem);
    }
  }

  /* ---------- Equipo ---------- */
  .equipo__grid {
    display: grid;
    gap: 3rem;
  }

  .equipo__texto {
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: 1.125rem;
  }

  .equipo__intro .link {
    margin-top: 0.5rem;
    text-decoration-line: underline;
  }

  /* En celular, dos cuadros por fila; con más barberos siguen en filas nuevas. */
  .equipo__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Si queda uno solo en la última fila, va centrado y del mismo ancho que los demás. */
  @media (max-width: 55.99rem) {
    .barbero:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc(50% - 0.5rem);
    }
  }

  /* Cuadro flash: marco exterior, paspartú e interior, como los cuadros del local. */
  .flash {
    position: relative;
